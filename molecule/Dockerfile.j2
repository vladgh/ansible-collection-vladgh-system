# Shared boot and Ansible prerequisites; scenario fixtures belong in prepare plays.
FROM {{ item.image }}

ENV container=docker

# Disable virtual consoles and host device management, as in the reference image.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        dbus \
        iproute2 \
        python3 \
        python3-apt \
        sudo \
        systemd \
        systemd-sysv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl mask \
        getty.target \
        systemd-udevd.service \
        systemd-udevd-control.socket \
        systemd-udevd-kernel.socket \
        systemd-udev-trigger.service

STOPSIGNAL SIGRTMIN+3

CMD ["/sbin/init"]
